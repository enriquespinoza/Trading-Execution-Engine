EXECUTION_MODE=simulation

# Twilio credentials. Never commit real values.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TRADE_ALERT_TO_NUMBER=

# Human approval gate.
TRADE_APPROVAL_TTL_MINUTES=10
TRADE_APPROVAL_STORE=state/approvals.json

# Exact public HTTPS URL configured in Twilio for inbound SMS.
# Example: https://example.ngrok.app/sms/approval
TWILIO_APPROVAL_WEBHOOK_URL=

# Local Flask listener used behind the public HTTPS endpoint.
APPROVAL_WEBHOOK_HOST=127.0.0.1
APPROVAL_WEBHOOK_PORT=5000
