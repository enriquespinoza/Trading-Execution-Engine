EXECUTION_MODE=simulation

# Primary phone approval path: ntfy push.
# For initial testing, use long random topic names.
NTFY_BASE_URL=https://ntfy.sh
NTFY_ALERT_TOPIC=
NTFY_RESPONSE_TOPIC=
NTFY_ACCESS_TOKEN=

# Human approval gate.
TRADE_APPROVAL_TTL_MINUTES=10
TRADE_APPROVAL_STORE=state/approvals.json

# Optional legacy Twilio SMS adapter.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TRADE_ALERT_TO_NUMBER=
TWILIO_APPROVAL_WEBHOOK_URL=
APPROVAL_WEBHOOK_HOST=127.0.0.1
APPROVAL_WEBHOOK_PORT=5000
