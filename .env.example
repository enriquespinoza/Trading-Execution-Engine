EXECUTION_MODE=simulation

# Primary phone approval path: authenticated ntfy push.
NTFY_BASE_URL=https://ntfy.sh
NTFY_ALERT_TOPIC=
NTFY_RESPONSE_TOPIC=

# Use separate least-privilege identities/tokens:
# - alert publisher: WRITE only on NTFY_ALERT_TOPIC
# - response publisher: WRITE only on NTFY_RESPONSE_TOPIC
# - response reader: READ only on NTFY_RESPONSE_TOPIC
NTFY_ALERT_PUBLISH_TOKEN=
NTFY_RESPONSE_PUBLISH_TOKEN=
NTFY_RESPONSE_READ_TOKEN=

# Local HMAC key for signed, trade-bound, one-time approvals.
# Generate locally with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
TRADE_APPROVAL_SIGNING_KEY=

TRADE_APPROVAL_TTL_MINUTES=10
TRADE_APPROVAL_STORE=state/approvals.json

# Optional legacy Twilio SMS adapter.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TRADE_ALERT_TO_NUMBER=
TWILIO_APPROVAL_WEBHOOK_URL=
APPROVAL_WEBHOOK_HOST=127.0.0.1
APPROVAL_WEBHOOK_PORT=5000
